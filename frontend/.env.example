# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# Backend API Endpoint URL
# If serving directly from Express backend, leave empty or use http://localhost:3000
BACKEND_API_URL=http://localhost:3000

# Supabase Public Database Credentials (Safe for browser client)
# Obtain from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Client Default Model
GEMINI_DEFAULT_MODEL=gemini-1.5-flash

# Application Branding
APP_NAME="Gemini Chatbot"
