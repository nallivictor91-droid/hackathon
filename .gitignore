# ==============================================================================
# Git Ignore Configuration
# Protects secrets, credentials, dependencies, and environment files from GitHub
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & Credentials (CRITICAL)
# ------------------------------------------------------------------------------
# Ignore all .env files containing API keys and private tokens
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Keep .env.example files committed so collaborators have templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Debug & Error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 4. Code Editors & IDEs
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Build, Cache & Temporary Files
# ------------------------------------------------------------------------------
dist/
build/
out/
tmp/
temp/
logs/
*.log
.cache/

# Agent & AI tool generated local folders
.gemini/
.agents/
