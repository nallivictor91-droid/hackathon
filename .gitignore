# ==============================================================================
# PULSEFLOW AI — COMPREHENSIVE GITIGNORE CONFIGURATION
# Protects secrets, API keys, credentials, build outputs, and dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT SECRETS & PRIVATE CREDENTIALS (CRITICAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.evn
.evn.*
*.evn
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Subdirectory environment files
backend/.env
backend/.env.*
backend/*.env
backend/.evn
backend/.evn.*
backend/*.evn
frontend/.env
frontend/.env.*
frontend/*.env
frontend/.evn
frontend/.evn.*
frontend/*.evn

# Keep .env.example templates committed so team members have reference structures
!.env.example
!backend/.env.example
!frontend/.env.example

# Private certificates, tokens, and SSH keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.id_rsa
*.id_ed25519

# ------------------------------------------------------------------------------
# 2. DEPENDENCIES & PACKAGE MANAGERS
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnp.*

# Debug & Error logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. BUILD OUTPUTS & COMPILED ARTIFACTS
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
backend/dist/
frontend/dist/
*.tsbuildinfo
.tsbuildinfo
node_modules/.tmp/
frontend/node_modules/.tmp/
backend/node_modules/.tmp/
.cache/
.vite/
frontend/.vite/

# Temporary uploads and document OCR scratch
uploads/
backend/uploads/
temp/
tmp/

# ------------------------------------------------------------------------------
# 4. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory

# ------------------------------------------------------------------------------
# 5. IDE & CODE EDITORS
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*.sw?

# ------------------------------------------------------------------------------
# 6. TESTING & COVERAGE
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov

# ------------------------------------------------------------------------------
# 7. SUPABASE & LOCAL INFRASTRUCTURE CACHE
# ------------------------------------------------------------------------------
.supabase/
supabase/.temp/
supabase/.branches/

# AI Tooling & Local Agent Scratchpads
.gemini/
.agents/
.system_generated/
scratch/
