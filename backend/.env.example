# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server Port
PORT=3000

# Google Gemini API Key
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase Database Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
# URL Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE

# Supabase Anon / Public Key (Safe for standard database access)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase Service Role Key (Optional: for backend admin access / bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Default Session ID for grouping chat messages
DEFAULT_SESSION_ID=default-session
